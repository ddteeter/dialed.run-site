---
/**
 * /open-source (HANDOFF §7): see src/components/oss/OpenSourcePage.astro.
 * The list is the committed src/lib/oss/open-source-list.json, which every
 * build regenerates from what it ships.
 */
import OpenSourcePage from "@/components/oss/OpenSourcePage.astro";
import { licenceGroups, openSourceList, toolsGroup } from "@/lib/oss/groups";

const list = openSourceList();
---

<OpenSourcePage groups={licenceGroups(list)} tools={toolsGroup(list)} />
