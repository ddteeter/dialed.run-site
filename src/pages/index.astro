---
/**
 * M1 Home: one promise, one proof, three steps, one ask.
 *
 * The guide strip and the nav's What to wear link arrive with the guides
 * (Phase 2); they render only once a band is published.
 */
import CallCard from "@/components/CallCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import PillLink from "@/components/PillLink.astro";
import { app, paths } from "@/config/urls";
import { getGuideArtifact } from "@/data/artifact/load";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { webApplication } from "@/lib/jsonLd";

const description =
  "dialed.run remembers what you wore, the weather you ran in, and whether you got it right, then makes the call the night before your next run.";
const { callCard } = await getGuideArtifact();

const steps = [
  {
    title: "Log the run",
    body: "From Strava or a file. Weather comes with it and is never typed by hand.",
  },
  {
    title: "Say how it went",
    body: "Way cold to way warm, and what was off. Ten seconds.",
  },
  {
    title: "Get the call",
    body: "Your kit for tomorrow's forecast, from what worked for you.",
  },
];
---

<BaseLayout
  title="dialed.run · What to wear running, from your own runs"
  description={description}
>
  <JsonLd slot="head" node={webApplication(description)} />

  <div class="mx-auto grid max-w-page gap-6 px-5 py-8 wide:px-6 wide:py-12 desk:grid-cols-2 desk:items-center desk:gap-12">
    <div class="flex flex-col gap-5 wide:gap-6">
      <p class="m-0 mono-xs text-quiet">
        What to wear running · from your own runs
      </p>
      <h1 class="m-0 type-display">Wear what worked.</h1>
      <p class="m-0 type-lead">
        dialed.run remembers what you wore, the weather you ran in, and whether
        you got it right. The night before your next run, it makes the call.
      </p>
      <div class="flex flex-col items-stretch gap-2 wide:flex-row wide:items-center wide:gap-5">
        <PillLink href={paths.invite}>Request an invite</PillLink>
        <a
          href={app.join}
          class="inline-flex min-h-target items-center self-center font-semibold underline wide:self-auto"
        >
          Have a code? Join
        </a>
      </div>
    </div>
    {callCard && <CallCard card={callCard} />}
  </div>

  <section aria-labelledby="steps-title" class="border-t border-hairline">
    <h2 id="steps-title" class="sr-only">
      How dialed.run works
    </h2>
    <ol class="mx-auto m-0 grid max-w-page list-none p-0 wide:grid-cols-3">
      {steps.map((step, index) => (
        <li class="flex flex-col gap-2 border-hairline px-5 py-8 not-last:border-b wide:px-6 wide:not-last:border-r wide:not-last:border-b-0">
          <span class="mono-sm text-quiet" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="m-0 type-heading">{step.title}</h3>
          <p class="m-0">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
