---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import { env } from "@/config/env";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { getChangelogEntries } from "@/data/changelog";
import { getPublishedLegalSlugs } from "@/data/legal";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const published = await getPublishedLegalSlugs();
const hasChangelog = (await getChangelogEntries()).length > 0;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:inline-flex focus:min-h-target focus:items-center focus:bg-ground focus:px-4"
    >
      Skip to content
    </a>
    <SiteHeader launched={env.SITE_INDEXABLE} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter published={published} hasChangelog={hasChangelog} />
  </body>
</html>
