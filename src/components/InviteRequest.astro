---
/**
 * M5a: request an invite, in one of two modes (HANDOFF §4 M5, OPEN).
 *
 * - `endpoint` set (option a): one email field that POSTs to the app's
 *   public, Turnstile-guarded endpoint, which redirects back to
 *   /invite/sent with the same answer for every address. Plain HTML; the
 *   only script is Turnstile's, managed, above the primary button.
 * - `endpoint` unset (option b, the default until that endpoint exists):
 *   the primary links to the app's own request page. No form, no script.
 */
import PillLink from "./PillLink.astro";
import { paths } from "@/config/urls";

interface Props {
  endpoint: string | undefined;
  turnstileSiteKey: string | undefined;
  requestAccessUrl: string;
  privacyPublished: boolean;
}

const { endpoint, turnstileSiteKey, requestAccessUrl, privacyPublished } =
  Astro.props;
const field =
  "min-h-field w-full rounded-field border border-hairline-2 bg-panel px-4 py-3 type-field text-ink placeholder:text-placeholder";
---

{endpoint === undefined ? (
  <PillLink href={requestAccessUrl}>Request an invite</PillLink>
) : (
  <form method="post" action={endpoint} class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <label for="invite-email" class="mono-sm text-label">
        Email
      </label>
      <input
        id="invite-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        class={field}
      />
    </div>
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-appearance="interaction-only"
    />
    <button
      type="submit"
      class="inline-flex min-h-control cursor-pointer items-center justify-center rounded-pill border-0 bg-action px-6 type-body font-bold whitespace-nowrap text-on-accent hover:bg-action-hover"
    >
      Request an invite
    </button>
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  </form>
)}
<p class="m-0 type-micro text-quiet">
  {endpoint !== undefined && privacyPublished && (
    <>
      See the{" "}
      <a href={paths.privacy} class="underline">
        Privacy policy
      </a>{" "}
      for how we use this address.{" "}
    </>
  )}
  dialed.run is for runners 16 and over.
</p>
