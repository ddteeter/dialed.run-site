---
import { env } from "@/config/env";
import { buildHead } from "@/lib/head";
import FontPreloads from "./FontPreloads.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const head = buildHead({
  title,
  description,
  path: Astro.url.pathname,
  indexable: env.SITE_INDEXABLE,
  noindex,
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<FontPreloads />
<title>{head.title}</title>
<meta name="description" content={head.description} />
{head.robots && <meta name="robots" content={head.robots} />}
{head.canonical && <link rel="canonical" href={head.canonical} />}
<meta property="og:type" content={head.og.type} />
<meta property="og:title" content={head.og.title} />
<meta property="og:description" content={head.og.description} />
<meta property="og:url" content={head.og.url} />
<meta property="og:site_name" content="dialed.run" />
<meta property="og:image" content={head.og.image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="dialed.run: Wear what worked." />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<slot />
