---
/**
 * A legal text's blocks, as src/lib/legal/markdown.ts reads them. Each
 * section ends with a way back to the contents below desk, where the
 * contents column isn't beside the text.
 */
import type { Block } from "@/lib/legal/markdown";
import Inlines from "./Inlines.astro";

interface Props {
  blocks: readonly Block[];
}

const { blocks } = Astro.props;
const back =
  "inline-flex min-h-target items-center mono-sm text-muted desk:hidden";
---

{blocks.map((block, index) => {
  const endsSection =
    blocks.some((b, i) => i <= index && b.kind === "section") &&
    (index === blocks.length - 1 || blocks[index + 1]?.kind === "section");
  const backLink = endsSection && (
    <a href="#contents" class={back} aria-label="Back to contents">
      ↑ Contents
    </a>
  );
  switch (block.kind) {
    case "section":
      return (
        <h2 id={block.id} class="m-0 mt-4 type-heading">
          <Inlines inlines={block.inlines} />
        </h2>
      );
    case "subheading":
      return (
        <>
          <h3 class="m-0 font-semibold">
            <Inlines inlines={block.inlines} />
          </h3>
          {backLink}
        </>
      );
    case "paragraph":
      return (
        <>
          <p class="m-0">
            <Inlines inlines={block.inlines} />
          </p>
          {backLink}
        </>
      );
    case "quote":
      return (
        <>
          <blockquote class="m-0 border-l-2 border-hairline-2 pl-4 text-quiet">
            <Inlines inlines={block.inlines} />
          </blockquote>
          {backLink}
        </>
      );
    case "list":
      return (
        <>
          <ul class="m-0 flex list-disc flex-col gap-2 pl-6">
            {block.items.map((item) => (
              <li>
                <Inlines inlines={item} />
              </li>
            ))}
          </ul>
          {backLink}
        </>
      );
    case "numbered":
      return (
        <>
          <ol
            start={block.start}
            class="m-0 flex list-decimal flex-col gap-2 pl-6"
          >
            {block.items.map((item) => (
              <li>
                <Inlines inlines={item} />
              </li>
            ))}
          </ol>
          {backLink}
        </>
      );
    case "table":
      return (
        <>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr>
                  {block.head.map((cell) => (
                    <th
                      scope="col"
                      class="border-b border-ink py-2 pr-4 font-semibold"
                    >
                      <Inlines inlines={cell} />
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {block.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td class="border-b border-hairline py-2 pr-4 align-top">
                        <Inlines inlines={cell} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {backLink}
        </>
      );
  }
})}
