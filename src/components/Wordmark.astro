---
/**
 * The wordmark, [dialed.run] (design round 31 #6, direction 08): brackets in
 * --action, ".run" in --muted, set in TYPE.title.
 */
---

<span class="type-title whitespace-nowrap">
  <span class="text-action">[</span>dialed<span class="text-muted">.run</span>
  <span class="text-action">]</span>
</span>
